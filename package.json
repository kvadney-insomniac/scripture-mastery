{
  "name": "scripture-mastery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A spaced-repetition study system for whole-Bible survey knowledge.",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "E2E=1 vite --port 5174 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b --pretty",
    "validate": "vite-node scripts/validate.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:solo": "SOLO=1 tsc -b && SOLO=1 vite build",
    "hackathon:index": "vite-node hackathon/index.ts",
    "hackathon:verify": "vite-node hackathon/verify.ts",
    "hackathon:demo": "npm run hackathon:index && vite-node hackathon/generate-stub.ts \"understand Romans in 6 weeks\" && vite-node hackathon/verify.ts hackathon/out/plan.json",
    "hackathon:check": "tsc -p hackathon/tsconfig.json --pretty"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "quiz-difficulty": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-node": "^2.1.8"
  }
}
